<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Birthday Invitation - Alisha</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(
                135deg,
                #6a0dad,
                #b44cff,
                #ff69b4,
                #ff9bd7
            );
            background-size: 400% 400%;
            animation: gradientMove 10s ease infinite;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        @keyframes gradientMove {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .card {
            width: 100%;
            max-width: 650px;
            padding: 45px 30px;
            text-align: center;
            color: white;

            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 30px;

            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            box-shadow:
                0 20px 50px rgba(67, 0, 100, 0.35);

            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            top: -100px;
            left: -80px;
        }

        .card::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            background: rgba(255,255,255,0.12);
            border-radius: 50%;
            bottom: -80px;
            right: -60px;
        }

        .emoji {
            font-size: 55px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }
        }

        .small-title {
            margin-top: 10px;
            font-size: 18px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        h1 {
            margin-top: 15px;
            font-size: 42px;
            line-height: 1.2;
            font-weight: 700;
            text-shadow: 0 4px 15px rgba(70, 0, 80, 0.3);
        }

        .birthday {
            margin-top: 15px;
            font-size: 28px;
            font-weight: bold;
            color: #ffe3f5;
        }

        .age {
            margin: 25px auto;
            width: 120px;
            height: 120px;

            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;

            background: linear-gradient(
                135deg,
                #ffffff,
                #ffd6f2
            );

            color: #8e2de2;

            font-size: 42px;
            font-weight: bold;

            box-shadow:
                0 10px 30px rgba(80, 0, 100, 0.3);
        }

        .details {
            margin-top: 25px;
            display: grid;
            gap: 15px;
        }

        .detail-box {
            padding: 16px;

            border-radius: 18px;

            background: rgba(255,255,255,0.16);

            border: 1px solid rgba(255,255,255,0.25);

            font-size: 17px;
        }

        .detail-box strong {
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .message {
            margin-top: 25px;
            line-height: 1.7;
            font-size: 16px;
        }

        .button {
            display: inline-block;

            margin-top: 30px;
            padding: 14px 30px;

            border: none;
            border-radius: 30px;

            background: white;
            color: #8e2de2;

            font-size: 16px;
            font-weight: bold;

            cursor: pointer;

            text-decoration: none;

            box-shadow:
                0 8px 20px rgba(80,0,100,0.25);

            transition: 0.3s;
        }

        .button:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow:
                0 12px 25px rgba(80,0,100,0.35);
        }

        .footer {
            margin-top: 25px;
            font-size: 14px;
            opacity: 0.8;
        }

        /* Dekorasi hati */

        .heart {
            position: fixed;
            font-size: 25px;
            animation: float 6s linear infinite;
            opacity: 0.7;
            pointer-events: none;
        }

        @keyframes float {
            from {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }

            20% {
                opacity: 0.8;
            }

            to {
                transform: translateY(-10vh) rotate(360deg);
                opacity: 0;
            }
        }

        @media (max-width: 600px) {

            .card {
                padding: 35px 20px;
            }

            h1 {
                font-size: 30px;
            }

            .birthday {
                font-size: 22px;
            }

            .age {
                width: 100px;
                height: 100px;
                font-size: 35px;
            }

            .detail-box {
                font-size: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Kartu Undangan -->

    <div class="card">

        <div class="emoji">🎂✨</div>

        <div class="small-title">
            You're Invited
        </div>

        <h1>
            Alisha Himeka<br>
            Yuki Baheera
        </h1>

        <div class="birthday">
            14th Birthday
        </div>

        <div class="age">
            14
        </div>

        <div class="details">

            <div class="detail-box">
                <strong>📅 Tanggal</strong>
                12 Desember 2026
            </div>

            <div class="detail-box">
                <strong>📍 Tempat</strong>
                Cafe Gritt, Banjarbaru
            </div>

        </div>

        <div class="message">
            ✨ Ayo rayakan hari spesial ini bersama! ✨
            <br>
            Kehadiranmu akan membuat ulang tahun Alisha
            menjadi semakin indah dan berkesan. 💜💗
        </div>

        <a
            href="#"
            class="button"
            onclick="showMessage()"
        >
            💌 Konfirmasi Kehadiran
        </a>

        <div class="footer">
            With Love 💜 Alisha
        </div>

    </div>


    <!-- Hiasan hati -->

    <script>

        function showMessage() {
            alert(
                "Terima kasih! 💜💗\n" +
                "Sampai bertemu di ulang tahun Alisha yang ke-14! 🎂✨"
            );
        }


        // Membuat hati melayang

        function createHeart() {

            const heart = document.createElement("div");

            heart.classList.add("heart");

            const hearts = ["💜", "💗", "💕", "✨", "🎀"];

            heart.innerHTML =
                hearts[Math.floor(Math.random() * hearts.length)];

            heart.style.left =
                Math.random() * 100 + "vw";

            heart.style.animationDuration =
                (4 + Math.random() * 5) + "s";

            heart.style.fontSize =
                (15 + Math.random() * 20) + "px";

            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 9000);
        }

        setInterval(createHeart, 500);

    </script>

</body>
</html>
